{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anorak",
  "version": "0.1.0",
  "identifier": "dev.pauldolden.anorak",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "backgroundColor": "#0e1419"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "category": "Utility",
    "shortDescription": "Scouting tool for Football Manager saves"
  }
}
